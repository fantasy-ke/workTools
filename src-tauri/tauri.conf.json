{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "worktools",
  "version": "0.1.0",
  "identifier": "com.worktools.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "worktools",
        "width": 1360,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "shortDescription": "API 报文格式化、对比与 Cron 工作台",
    "longDescription": "worktools 是面向 API 对接工作的本地优先 JSON、XML、差异对比、Cron 与批量目录工作台。",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
